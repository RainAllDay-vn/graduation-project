{
  "markdown-pdf.displayHeaderFooter": true,
  "markdown-pdf.headerTemplate": "<span></span>",
  "markdown-pdf.sanitize": "gfm-allow-style",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[python]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
